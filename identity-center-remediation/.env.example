# Identity Center App Monitor - Environment Variables for Local Testing
# ========================================================================
# This file contains example environment variables for local Lambda testing.
# Copy this file to .env and update with your actual values.
#
# IMPORTANT: Never commit .env with real values to version control!
# The .env file should be in .gitignore

# ============================================
# Lambda Function Configuration
# ============================================

# Enable automatic deletion of non-compliant assignments
# Set to "true" to delete assignments, "false" for notification-only mode
# Default: false
ENABLE_AUTO_DELETION=false

# SNS Topic ARN for notifications
# Get this from CDK deployment output or AWS Console
# Format: arn:aws:sns:REGION:ACCOUNT-ID:IdentityCenterAppMonitor
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:IdentityCenterAppMonitor

# Identity Center Instance ARN (required)
# Find this in AWS Console: IAM Identity Center → Settings → ARN
# Format: arn:aws:sso:::instance/ssoins-xxxxxxxxxxxxxxxxxx
IDENTITY_CENTER_INSTANCE_ARN=arn:aws:sso:::instance/ssoins-xxxxxxxxxxxxxxxxxx

# Management Account ID (required)
# AWS Account ID where Identity Center is hosted (management or delegated admin account)
# Format: 12-digit account ID
MANAGEMENT_ACCOUNT_ID=123456789012

# Group Name Regex (optional)
# Regex pattern to extract friendly group name from full group name
# The first capture group is used as the friendly name
# Leave empty for default substring matching
# Examples:
#   - "^([^-]+)" extracts prefix before first dash (Dev-Team-AWS → Dev)
#   - "([^-]+)$" extracts suffix after last dash (AWS-Team-Dev → Dev)
#   - "\[([^\]]+)\]" extracts text between brackets (Team [Dev] AWS → Dev)
# Default: empty (use full group name)
GROUP_NAME_REGEX=

# ============================================
# Logging Configuration
# ============================================

# Log level for Lambda function
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# ============================================
# AWS Configuration (for local testing)
# ============================================

# AWS Region where Identity Center is deployed
# Default: us-east-1
AWS_REGION=us-east-1

# AWS Profile to use for local testing (optional)
# Uncomment and set if using named profiles
# AWS_PROFILE=my-profile

# ============================================
# Testing Configuration
# ============================================

# Set to "true" to enable mock mode for testing without real AWS calls
# Default: false
MOCK_MODE=false

# Set to "true" to enable verbose logging during tests
# Default: false
VERBOSE_TESTING=false

# ============================================
# Example Usage
# ============================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Update values in .env with your actual configuration
#
# 3. Load environment variables (bash/zsh):
#    export $(cat .env | xargs)
#
# 4. Or use with Python:
#    from dotenv import load_dotenv
#    load_dotenv()
#
# 5. Run Lambda function locally:
#    cd lambda
#    python -c "from handler import lambda_handler; lambda_handler(event, context)"
#
# 6. Run tests with environment:
#    cd lambda
#    pytest
#
# ============================================
# Security Notes
# ============================================
#
# - Never commit .env files with real credentials
# - Use IAM roles in production, not environment variables
# - Rotate credentials regularly
# - Use AWS Secrets Manager for sensitive values in production
# - Ensure .env is in .gitignore
